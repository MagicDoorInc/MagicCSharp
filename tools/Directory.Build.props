<Project>

  <!--
    Deliberately does NOT import the repository's Directory.Build.props.

    These scripts are compiled and run by the SDK on whichever machine is doing the scaffolding, so they must
    not inherit the repository's target framework — a repo targeting net9.0 would otherwise produce scripts
    the .NET 10 runtime refuses to launch. They are tooling, not part of the product, so they also opt out of
    the repository's warnings-as-errors.

    Keep this file next to the scripts when copying tools/ into a repository.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
