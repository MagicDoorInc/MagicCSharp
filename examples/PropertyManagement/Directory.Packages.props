<Project>

  <!--
    Central package management: a .csproj says which packages it needs, this file says which version.
    One version per package across the repository, so two projects cannot disagree about it.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="MagicCSharp">
    <PackageVersion Include="MagicCSharp" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.Analyzers" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.App" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.AspNetCore" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.Data" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.Data.EntityFramework" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.Data.Postgres" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.Events" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.Events.Kafka" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.Scheduling" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.Testing" Version="1.0.1" />
    <PackageVersion Include="MagicCSharp.Testing.Database" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup Label="Locking">
    <PackageVersion Include="DistributedLock.Core" Version="1.0.8" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup Label="Web">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
