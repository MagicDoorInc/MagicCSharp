<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Acme.Leasing.Domains.Charges.LateFees.App</AssemblyName>
    <RootNamespace>Acme.Leasing.Domains.Charges.LateFees.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared framework rather than a package: ControllerBase, HttpContext and the MVC attributes
         come from it, and it adds nothing to the published output. Controllers in here are found by the
         host because it references this project — there is no AddApplicationPart to write. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MagicCSharp" />
    <!-- HttpExceptions, so a use case here can throw the thing that becomes a 404, and the request-id
         types. Not MagicCSharp.App: that is the host bootstrap, and this is a library. -->
    <PackageReference Include="MagicCSharp.AspNetCore" />
    <PackageReference Include="MagicCSharp.Scheduling" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Default\Acme.Leasing.Domains.Charges.LateFees.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\..\Libs\Web\Default\Acme.Libraries.Web.csproj" />
  </ItemGroup>

</Project>
