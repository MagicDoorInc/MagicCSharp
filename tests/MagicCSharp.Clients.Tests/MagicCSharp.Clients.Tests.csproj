<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\MagicCSharp.Clients\MagicCSharp.Clients.csproj"/>
        <ProjectReference Include="..\..\src\MagicCSharp.Testing\MagicCSharp.Testing.csproj"/>
        <ProjectReference Include="..\..\src\MagicCSharp.Testing.Clients\MagicCSharp.Testing.Clients.csproj"/>
        <!-- The generators run on this project as they run on a consumer's, so the tests call the clients and fake
             bases the compiler wrote. The declarations dll is passed too: the compiler loads the generators'
             dependency from the analyzers it was given. -->
        <ProjectReference Include="..\..\src\MagicCSharp.Generators\MagicCSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\..\src\MagicCSharp.Generators.Declarations\MagicCSharp.Generators.Declarations.csproj" OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="xunit" Version="2.9.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
