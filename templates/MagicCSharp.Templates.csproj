<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageId>MagicCSharp.Templates</PackageId>
        <!-- Read from the file publish-all.sh bumps. This project sits outside src/, so it does not inherit
             the <Version> in src/Directory.Build.props, and a hardcoded value here was left behind at
             0.0.11 while every other package moved on. -->
        <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../scripts/version.txt').Trim())</Version>
        <Authors>MagicCSharp Contributors</Authors>
        <Company>MagicCSharp</Company>
        <Title>MagicCSharp repository template</Title>
        <Description>dotnet new template for a MagicCSharp repository: several services in one repository, each with its own solution, sharing a set of libraries. Pair it with the MagicCSharp.Cli tool (mcs) to create services, domains, shared libraries and entities, and to lint the conventions the compiler cannot. Optional; the MagicCSharp packages work in any layout.</Description>
        <PackageTags>dotnet-new;templates;clean-architecture;monorepo;scaffolding</PackageTags>
        <PackageProjectUrl>https://github.com/MagicDoorInc/MagicCSharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/MagicDoorInc/MagicCSharp.git</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <TargetFramework>net9.0</TargetFramework>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnableDefaultItems>false</EnableDefaultItems>
        <!-- Apps/ and Libs/ ship as empty directories held open by .gitkeep, and NuGet excludes dotfiles
             by default — without this the generated repository is missing both. -->
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <!-- A template package carries no assemblies, which is what NU5128 complains about. -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    </PropertyGroup>

    <!-- The repository skeleton. The tooling is the MagicCSharp.Cli global tool, not vendored scripts. -->
    <Target Name="IncludeTemplateContent" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <!-- PackagePath set explicitly rather than via ContentTargetFolders, which would nest the
                 already-content-rooted paths a second time. -->
            <Content Include="content\**\*"
                     Exclude="content\**\bin\**;content\**\obj\**"
                     PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
