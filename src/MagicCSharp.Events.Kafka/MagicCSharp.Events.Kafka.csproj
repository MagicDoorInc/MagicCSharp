<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- NuGet Package Properties -->
        <PackageId>MagicCSharp.Events.Kafka</PackageId>
        <Description>Kafka event dispatcher and consumer implementation for MagicCSharp.Events</Description>
        <PackageTags>csharp;events;kafka;event-driven</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../MagicCSharp.Events/MagicCSharp.Events.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Confluent.Kafka" Version="2.6.1"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
