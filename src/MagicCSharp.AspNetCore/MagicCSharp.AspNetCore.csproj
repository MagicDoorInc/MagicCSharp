<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\MagicCSharp\MagicCSharp.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet Package Metadata -->
        <PackageId>MagicCSharp.AspNetCore</PackageId>
        <Version>0.0.11</Version>
        <Authors>MagicCSharp Contributors</Authors>
        <Company>MagicCSharp</Company>
        <Description>ASP.NET Core integration for MagicCSharp: request ID middleware that accepts or generates a correlation ID per request and flows it through async calls and logs.</Description>
        <PackageTags>aspnetcore;middleware;request-id;correlation;clean-architecture</PackageTags>
        <PackageProjectUrl>https://github.com/MagicDoorInc/MagicCSharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/MagicDoorInc/MagicCSharp.git</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- FrameworkReference rather than the Microsoft.AspNetCore.Http.Abstractions package: that package
             is pinned at 2.2.0 and has not shipped since ASP.NET Core 2.2. Referencing the shared framework
             gets the current types and adds nothing to the output. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
