<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Loaded by the compiler next to the generators that use it, so the same rule as for any analyzer:
             netstandard2.0 is the only target every compiler host (Visual Studio's .NET Framework included) loads. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- Not a package of its own: MagicCSharp.Generators packs this dll into its analyzers/ folder, where a
             generator in another repository compiles against it and the compiler loads it. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- 4.8 is the .NET 8 SDK's compiler, the oldest one that can load what is built against it. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The analyzers' word splitting, compiled in rather than referenced: the two packages load separately. -->
        <Compile Include="..\MagicCSharp.Analyzers\IdentifierWords.cs" Link="Shared\IdentifierWords.cs"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>

</Project>
