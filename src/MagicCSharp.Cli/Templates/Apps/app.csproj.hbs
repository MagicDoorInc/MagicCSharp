<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>{{ prefix }}.{{ name }}.App</AssemblyName>
    <RootNamespace>{{ prefix }}.{{ name }}.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings in MagicCSharp, .AspNetCore, .Events and .Scheduling. Reference those directly instead if
         you would rather wire each piece yourself. -->
    <PackageReference Include="MagicCSharp.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
{{ if database.enabled }}
  <ItemGroup>
    <ProjectReference Include="..\Data\Data.EntityFramework\{{ prefix }}.{{ name }}.Data.EntityFramework.csproj" />
  </ItemGroup>
{{ end }}
</Project>
