<Project>

  <!--
    Every project in the repository inherits these, so a .csproj carries only what is specific to it.

    net10.0 is the current release. The MagicCSharp packages target net9.0 so that net9 applications can
    still consume them; a net10 application consumes a net9 library without ceremony, so there is no reason
    for a new repository to start a version behind.
  -->
  <PropertyGroup>
    <TargetFramework>{{ target_framework }}</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
{{- if build_rules }}

  <!--
    The code-style rules, as compile errors in every project, tests included. Change a rule's severity or turn
    it off in .editorconfig:
    https://github.com/MagicDoorInc/MagicCSharp/blob/master/src/MagicCSharp.Analyzers/README.md
  -->
  <ItemGroup>
    <PackageReference Include="MagicCSharp.Analyzers" PrivateAssets="all" />
  </ItemGroup>
{{- end }}

</Project>
